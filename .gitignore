# Первоисточники нормативки в корне — большие файлы, в репо не нужны (хранить локально).
# ⚠ Из корпуса в git едет только РАЗОБРАННЫЙ текст (knowledge_base/), а не исходник:
# 18 МБ RTF постановления и 1.6 МБ выгрузки с alta.ru репозиторию ничего не дают,
# а история необратима. Конвертеры лежат в scripts/ — разбор воспроизводится по файлу.
*.rtf
# ⚠ ТОЛЬКО КОРЕНЬ (ведущий слэш). Без него `*.docx` накрыл бы docs/CONCEPT_v1.0 и v2.0 —
# они законно в репо. Отслеживаемые файлы правило не снимает, но СЛЕДУЮЩАЯ версия концепции
# исчезла бы из `git status` молча: предохранитель, бьющий по верному, дороже отсутствующего.
/*.pdf
/*.doc
/*.docx

# Кэш эмбеддингов e5 (локальный, не коммитим)
.emb_cache/

# Граф знаний graphify — локальный, в репо не нужен
graphify-out/

# Рабочая папка diff_edition.py и разовых сверок редакций
scratchpad/

# Выгрузки с боевого сервера — ПЕРСОНАЛЬНЫЕ ДАННЫЕ (152-ФЗ): диалоги реальных пользователей
# региональных ТПП, дампы БД, таблицы выданных доступов. В git НИКОГДА (история необратима,
# приватность репозитория этого не отменяет). Хранить вне рабочего дерева — см. CLAUDE.md.
navigator-export/
backups/
*_backup*.db
dump_tables.json

# рабочие worktree Claude Code и посторонние файлы в корне — не код проекта
.claude/worktrees/
/*.xlsx
