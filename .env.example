# Скопировать в .env и заполнить реальными значениями
# Никогда не коммитить .env в git

# DeepSeek API — platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
# Модель и адрес API. Менять не нужно; вынесены сюда, чтобы их можно было переопределить
# без правки кода (напр. при смене модели или прокси).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# База данных (SQLite для dev, PostgreSQL для prod)
DATABASE_URL=sqlite+aiosqlite:///./navigator.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/navigator719

# Qdrant vector database
# Порт 6333 — стандартный для Qdrant и дефолт в config.py (работает из коробки).
# Если 6333 занят локально — подними Qdrant на своём порту и поменяй URL здесь (.env
# перекрывает дефолт; напр. на dev-ПК используется http://localhost:6533).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pp719
# Корпус «Правила ведения реестра» (процедурные вопросы) — отдельная коллекция.
# Грузится scripts/load_rules_kb.py; дефолт в config.py, менять не обязательно.
QDRANT_RULES_COLLECTION=pp719_rules
# Кейсы, подтверждённые экспертом ТПП (петля обучения). Грузится scripts/seed_cases.py.
QDRANT_CASES_COLLECTION=verified_cases
# В эксперименте (ветка/worktree exp/*) задавай СВОЁ имя коллекции, чтобы load_kb.py
# не затёр рабочую pp719, на которой стоит приёмка эксперта. Напр.: pp719_exp_bge.
# Подробнее — docs/BRANCHING.md.

# Embeddings (локально, через sentence-transformers)
# Вариант 1 (по умолчанию): модель скачивается с HuggingFace при первом запуске.
#   На нестабильной сети/из РФ ставь пакет hf_xet (он в requirements — чанковая докачка)
#   и при необходимости раскомментируй зеркало HF_ENDPOINT ниже.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Вариант 2 (рекомендуется для РФ): скачать модель вручную в папку и указать АБСОЛЮТНЫЙ путь
#   (файлы model.safetensors, tokenizer.json, config.json, 1_Pooling/config.json и т.д.).
# EMBEDDING_MODEL=D:/navigator-719/models/multilingual-e5-large
EMBEDDING_DIM=1024

# Зеркало HuggingFace — раскомментировать, если CDN недоступен (CDN huggingface.co из РФ часто рвётся)
# HF_ENDPOINT=https://hf-mirror.com

# --- Поведение движка (флаги; дефолты в app/core/config.py) ----------------------------
# LLM-реранкер top-k: +1 вызов DeepSeek на запрос БЕЗ кода ОКПД2, поднял recall@1 0.95→0.98.
# Выключить = быстрее и дешевле, но точнее не станет. При совпадении по коду не вызывается.
RERANK_ENABLED=true
# R30: минимальный dense-косинус, при котором кейс эксперта допускается в контекст ответа.
# Кейсы идут с ВЫСШИМ приоритетом, поэтому нерелевантный кейс — не шум, а правдоподобная
# дезинформация. Идеального порога нет (полосы перекрываются), 0.84 — измеренная рабочая
# точка: ложных 1/22 против 22/22 без порога, уместных сохраняется 13/14.
# Ниже 0.82 — кейс полезет почти на любой товарный вопрос; выше 0.86 — начнёт терять уместные.
# Кейс с кодом ОКПД2 проходит и мимо порога, если код назван в запросе (код авторитетнее).
# Перекалибровать по мере роста коллекции: scripts/calibrate_cases.py
CASE_RELEVANCE_MIN=0.84
# Процедурная ветка. DEFLECT — детектировать процедурный интент и уводить с товарного пути;
# ANSWER_FROM_RULES — отвечать по корпусу pp719_rules. Если ANSWER выключить, сервис честно
# скажет, что ответы по процедуре отключены (см. app/rag/procedural.DEFLECTION_DISABLED).
PROCEDURAL_DEFLECT_ENABLED=true
PROCEDURAL_ANSWER_FROM_RULES=true

# --- Ограничение частоты запросов (скользящее окно 60 с, в памяти процесса) --------------
# Чат — на пользователя: защищает единственную платную статью проекта (токены DeepSeek) от
# зациклившейся вкладки. Ответ движка занимает 10–30 с, поэтому 20/мин человек не превысит.
RATE_LIMIT_CHAT_PER_MIN=20
# Вход — на IP: отсекает перебор пароля (bcrypt замедляет, но не останавливает).
# Успешный вход сбрасывает счётчик, чтобы забывчивость не блокировала человека.
RATE_LIMIT_LOGIN_PER_MIN=10

# Файловый лог loguru. Пусто = только stderr. На VM — путь на томе, чтобы пережить редеплой.
LOG_FILE=
# LOG_FILE=/data/app.log

# Web UI 1.0 (аутентификация / сессии / БД приложения)
# Секрет подписи сессионных кук. В ПРОДЕ ОБЯЗАТЕЛЬНО задать длинную случайную строку.
SESSION_SECRET=dev-insecure-secret-change-in-env
# БД приложения (users / messages / feedback). Синхронный SQLite; файл в .gitignore.
APP_DB_URL=sqlite:///./navigator_app.db

# Настройки приложения
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Имя и версия — для UI
APP_TITLE=Навигатор ПП РФ №719
APP_VERSION=0.5.0
# Тег выкаченного релиза для пометки версии во фронте. Обычно ПУСТО: выкатка пишет файл `RELEASE`
# в корень рабочей копии, и метка берётся оттуда. Заполнять руками только для эксперимента.
RELEASE_TAG=
ORG_NAME=Курская ТПП

# --- Домен и HTTPS (за Caddy, см. caddy/Caddyfile и docs/DEPLOY.md §«Домен») ---------------
# Публичный домен в PUNYCODE. Корень → лендинг, сервис.<домен> → сервис. Caddy сам выпускает
# сертификаты Let's Encrypt для обоих имён; покупать SSL у регистратора не нужно.
# Для 719-навигатор.рф:  PUBLIC_DOMAIN=xn--719--83dani8b8bqyy.xn--p1ai
# Пусто = локальный запуск без прокси (compose подставит localhost, сертификат самоподписанный).
PUBLIC_DOMAIN=
# Метка поддомена сервиса в PUNYCODE: «сервис» → xn--b1afk4ade (сервис.719-навигатор.рф,
# A-запись «сервис» в DNS). Кириллицей нельзя — Caddy матчит Host, который браузер шлёт в punycode.
APP_SUBDOMAIN=xn--b1afk4ade
# Флаг Secure у кук. На бою за HTTPS — true; локально по http — false (иначе вход не сработает).
COOKIE_SECURE=false
