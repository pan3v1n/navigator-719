# Скопировать в .env и заполнить реальными значениями
# Никогда не коммитить .env в git

# DeepSeek API — platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# База данных (SQLite для dev, PostgreSQL для prod)
DATABASE_URL=sqlite+aiosqlite:///./navigator.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/navigator719

# Qdrant vector database
# Порт 6333 — стандартный для Qdrant и дефолт в config.py (работает из коробки).
# Если 6333 занят локально — подними Qdrant на своём порту и поменяй URL здесь (.env
# перекрывает дефолт; напр. на dev-ПК используется http://localhost:6533).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pp719
# Корпус «Правила ведения реестра» (процедурные вопросы) — отдельная коллекция.
# Грузится scripts/load_rules_kb.py; дефолт в config.py, менять не обязательно.
QDRANT_RULES_COLLECTION=pp719_rules
# В эксперименте (ветка/worktree exp/*) задавай СВОЁ имя коллекции, чтобы load_kb.py
# не затёр рабочую pp719, на которой стоит приёмка эксперта. Напр.: pp719_exp_bge.
# Подробнее — docs/BRANCHING.md.

# Embeddings (локально, через sentence-transformers)
# Вариант 1 (по умолчанию): модель скачивается с HuggingFace при первом запуске.
#   На нестабильной сети/из РФ ставь пакет hf_xet (он в requirements — чанковая докачка)
#   и при необходимости раскомментируй зеркало HF_ENDPOINT ниже.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Вариант 2 (рекомендуется для РФ): скачать модель вручную в папку и указать АБСОЛЮТНЫЙ путь
#   (файлы model.safetensors, tokenizer.json, config.json, 1_Pooling/config.json и т.д.).
# EMBEDDING_MODEL=D:/navigator-719/models/multilingual-e5-large
EMBEDDING_DIM=1024

# Зеркало HuggingFace — раскомментировать, если CDN недоступен (CDN huggingface.co из РФ часто рвётся)
# HF_ENDPOINT=https://hf-mirror.com

# Telegram бот (опционально)
TELEGRAM_BOT_TOKEN=

# Web UI 1.0 (аутентификация / сессии / БД приложения)
# Секрет подписи сессионных кук. В ПРОДЕ ОБЯЗАТЕЛЬНО задать длинную случайную строку.
SESSION_SECRET=dev-insecure-secret-change-in-env
# БД приложения (users / messages / feedback). Синхронный SQLite; файл в .gitignore.
APP_DB_URL=sqlite:///./navigator_app.db

# Настройки приложения
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Имя и версия — для UI
APP_TITLE=Навигатор ПП РФ №719
APP_VERSION=0.5.0
ORG_NAME=Курская ТПП
