# Профиль релиза v0.5.0-test15 (25.08.2026) — заход 5: K13 + K15.
#
# Вошли: K13 #46 (юридическая иерархия источников в промпте), K15 #36 ОБЕИМИ половинами
# (закрытый справочник подтверждающих документов + Методрекомендации ТПП вер. 1.18.3 в корпусе),
# EV14 #98 (база сравнения обновлена до v0.5.0-test14), O4 #107 (скрипты замера не падают на
# консоли Windows: долг 36 -> 25).
#
# ⚠⚠ ВЫКАТКА С ПОЛНОЙ ПЕРЕИНДЕКСАЦИЕЙ `pp719_rules`, А НЕ ЧАСТИЧНОЙ (K11). Причина не в объёме
# правки, а в устройстве BM25: `avgdl` считается по ВСЕМУ корпусу и ЗАПЕКАЕТСЯ в sparse-вектор
# каждой точки. Новый документ меняет среднюю длину для ВСЕХ — и в чужом масштабе оказываются не
# его точки, а точки СОСЕДЕЙ, загруженных раньше. Замерено на этом самом документе:
# 95.84 -> 96.72 (+0.92 %). Сам загрузчик частичную загрузку и не даст сделать: `--doc` для
# документа, которого нет в коллекции, останавливается и требует полной (обход —
# `--allow-new-doc`, но он здесь НЕ нужен и ставить его не надо).
#
# ⚠ ЦЕНА, КОТОРУЮ НАДО ЗНАТЬ ДО ЗАПУСКА: `recreate_collection` СНОСИТ коллекцию, и всё время
# прогона e5 процедурная ветка отвечает пустотой. Проверено локально: сразу после старта
# points_count = 0, дальше растёт до 328. Это ровно то окно, ради устранения которого делалась
# K11, и здесь его не избежать. Товарная ветка (`pp719`) при этом работает — её не трогаем.
#
# ⚠ Товарный корпус `pp719` НЕ переиндексируется. Паспорт там аддитивный, а K13 берёт
# `legal_force` из МАНИФЕСТА по `doc_type`, не из payload — именно затем, чтобы правка осталась
# рантаймовой для корпусов без паспорта в точках.

TAG="v0.5.0-test15"

# ⚠ pp719_rules 311 -> 328: +17 записей Методрекомендаций (6 разделов, нарезка по 1200 символов).
EXPECT=([pp719]=1377 [pp719_rules]=328 [verified_cases]=12)

# Снапшот не используется — корпус пересобирается на месте (см. врезку выше про канал до VM
# в профиле v0.5.0-test14: 1.08 ГБ туда не уедут).
SNAPSHOT=""
SNAPSHOT_COLLECTION="pp719_rules"

# ⚠ ПОЛНАЯ переиндексация. REINDEX_DOCS обязан остаться ПУСТЫМ: скрипт считает профиль,
# задавший оба, противоречивым и выходит кодом 2 (частичная загрузка после пересоздания
# коллекции бессмысленна).
REINDEX_FULL="pp719_rules"
REINDEX_DOCS=""

# Маркеры распакованного кода: файл|шаблон|описание. Шаблон ловит ОПРЕДЕЛЕНИЕ, а не упоминание —
# урок 18.08: grep по имени константы поймал её в комментарии и остановил ВЕРНУЮ выкатку.
MARKERS=(
  "app/core/manifest.py|^def legal_force_by_doc|K13: сила источника из манифеста, а не из payload"
  "app/core/manifest.py|^LEGAL_FORCE_NAMES|K13: ранг печатается словами, а не одним числом"
  "app/rag/documents_ref.py|^CONFIRMING_DOCUMENTS|K15: закрытый перечень подтверждающих документов"
  "app/rag/documents_ref.py|^def unverified_documents|K15: гард на несуществующий документ"
  "app/rag/pipeline.py|show_legal_force|K13: сила доезжает до контекста процедурного ответа"
  "app/core/prompts.py|1а. ЮРИДИЧЕСКАЯ СИЛА ИСТОЧНИКА|K13: правило промпта, без него строка — шум"
  "app/core/prompts.py|3б. СПРАВОЧНИК ДОКУМЕНТОВ|K15: перечень объявлен закрытым"
  "app/rag/retriever.py|metodrek_tpp|K15: разъяснение не занимает место нормы в окне (квота)"
  "scripts/load_rules_kb.py|^def parse_metodrek|K15: разбор Методрекомендаций"
  "scripts/load_rules_kb.py|^def cut_fragments|K15: исключение отменённых фрагментов на загрузке"
  "scripts/load_rules_kb.py|^def _document_has_points|K11: добавление документа != переиндексация"
  "knowledge_base/manifest.yaml|^  - doc_type: metodrek_tpp|K15: документ описан в манифесте"
  "knowledge_base/pp719/metodrek_tpp_full.txt|^1. ВВЕДЕНИЕ|K15: текст документа доехал в пакете"
)

# Анти-маркеры: код, которого в пакете быть НЕ должно.
# ⚠ Здесь их нет намеренно, и это не пропуск. Заход 5 ничего не УДАЛЯЛ: K13 и K15 только
# добавляют. Выдумывать анти-маркер ради заполненности поля значит завести предохранитель,
# который может ударить только по верному коду, — а такой дороже отсутствующего (урок 20.08).
ANTI_MARKERS=()
