# Маркеры. ⚠ Каждый сверен `grep -cE` 23.09.2026 против нового кода и против `8877cec` (бой):
# в новом ≥1, в старом 0. Без `|` внутри шаблона.
MARKERS=(
  "docker-compose.yml|^  caddy:|контейнер caddy — единственный вход снаружи"
  "caddy/Caddyfile|reverse_proxy app:8000|сервис за прокси"
  "landing/index.html|id=.open-app.|лендинг с кнопкой «Открыть сервис»"
  "app/core/config.py|^    COOKIE_SECURE: bool|флаг Secure стал настройкой"
  "app/api/auth.py|secure=settings.COOKIE_SECURE|Secure у куки «запомнить меня»"
  "main.py|https_only=settings.COOKIE_SECURE|Secure у сессионной куки"
  "scripts/deploy/deploy.sh|compose up -d app caddy|выкатка поднимает caddy"
  "app/core/release.py|^def release_label|метка релиза (из test25)"
  "main.py|.release.: release_label\\(\\)|/ping отдаёт метку (из test25)"
  "app/rag/pipeline.py|ЗАМЕРЕН И ОТКАЧЕН|отказ по доберу записан (из test25)"
)

# ⚠ Анти-маркеры ловят ОПРЕДЕЛЕНИЕ: `"80:8000"` упоминается и в комментарии нового compose
# («раньше здесь было»), поэтому шаблон — строка публикации порта целиком, с отступом и дефисом.
# Оба подтверждены на `8877cec` (старый ≥1, новый 0).
ANTI_MARKERS=(
  "docker-compose.yml|^      - .80:8000.|порт 80 всё ещё у приложения — прежний compose"
  "main.py|https_only=False,|прежняя сессионная кука без Secure"
  "main.py|.version.: settings.APP_VERSION\\}|прежний /ping без поля release"
)
