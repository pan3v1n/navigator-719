# Профиль релиза v0.5.0-test12 (20.08.2026) — ОБРАЗЕЦ и одновременно рабочий профиль
# последней выкатки. Копировать под новый тег, менять TAG, EXPECT, MARKERS.
#
# Правки EV13 #97: четыре дефекта разбора порогов. Выкатка РАНТАЙМОВАЯ — корпус не менялся,
# поэтому SNAPSHOT пуст и счётчики коллекций обязаны ОСТАТЬСЯ прежними.

TAG="v0.5.0-test12"

# Счётчики коллекций после выкатки. Расхождение = провал проверки, а не «наверное, ок».
EXPECT=([pp719]=1377 [pp719_rules]=311 [verified_cases]=12)

# Снапшот коллекции. Пусто = корпус не трогаем. Заполнять ТОЛЬКО когда изменился состав записей:
# `sync_payloads.py` приводит payload существующих точек, но лишние НЕ удаляет.
SNAPSHOT=""
SNAPSHOT_COLLECTION="pp719"

# Маркеры распакованного кода: файл|шаблон|описание.
# ⚠ Шаблон обязан ловить ОПРЕДЕЛЕНИЕ, а не упоминание — иначе комментарий об удалении константы
#   остановит верную выкатку (так и было 18.08).
MARKERS=(
  "app/rag/thresholds.py|^def _closes_name|EV13: граница закрывающей кавычки покрывает « и » / « (»"
  "app/rag/thresholds.py|^_STEP_RE|EV13: признак ступени графика, а не любой строки с «не менее»"
  "app/rag/thresholds.py|^def _is_coefficient_note|EV13: страж коэффициентов"
  "app/rag/thresholds.py|^def _split_exception|прим. 17: оговорка отделена от общего графика"
  "app/rag/thresholds.py|^def lookup_procurement_threshold|K2: закупочный порог отдельной строкой"
  "app/rag/fragments.py|^def group_of|R29/EV6: группа расколотой ячейки"
  "app/rag/pipeline.py|^def target_hits|EV7: «кто целевой» решается в одном месте"
  "app/core/prompts.py|ИНОЙ порог|правило 2г: несколько порогов разной природы"
)

# Анти-маркеры: код, которого в пакете быть НЕ должно (старая копия распаковалась поверх).
ANTI_MARKERS=(
  "app/rag/thresholds.py|years = hcells if len\(hcells\) >= 2 else|фолбэк синтеза подписей колонок (снят EV13)"
)

# Релизные проверки рантайма. Общие лежат в checks/common и идут на каждом релизе.
# Каталога checks/v0.5.0-test12 нет намеренно: всё, что проверял этот релиз, оказалось
# регрессионным и переехало в common.
