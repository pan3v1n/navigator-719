# Профиль релиза v0.5.0-test18 (26.08.2026) — EV21 #119 + K15-1 #120 + P3 #121 + пакет ревью.
#
# ЧТО МЕНЯЕТ ПОВЕДЕНИЕ (три вещи, остальное — код замера):
#
# 1. `P3` #121 — МАРШРУТ ВОПРОСА. До правки 13 из 25 вопросов приёмочного набора `K9` не доходили
#    до процедурной ветки и отвечались по ТОВАРНОМУ корпусу: «как получить выписку из реестра» →
#    регистраторы данных рейса, «что делать если заявку направили на доработку» → подруливающие
#    устройства. Проверено живьём, не выведено. Не поймала ни одна метрика: `eval_rules` дёргает
#    `search_rules` напрямую, минуя гейт. Теперь маршрут спрашивает НАМЕРЕНИЕ (`topics.classify`),
#    но только с 719-якорем и кроме темы `documents`. Свип: пропуски 17 → 11, ложных 1 (прежнее),
#    вне сферы 0, документные кейсы по своим маршрутам.
#
# 2. `K15-1` #120 — ГЕЙТ ЗАКРЫТОГО СПРАВОЧНИКА. Асимметрия в соседних строках списка маркеров (у
#    глагола «внести … в реестр» разрыв до 4 слов, у отглагольного «внесение … в реестр» — ноль)
#    уводила вопрос «нужно ли заключение ТПП для ВНЕСЕНИЯ ПРОДУКЦИИ в реестр» на товарную ветку,
#    где справочника нет, — и ответ УТВЕРЖДАЛ несуществующий документ 3 прогона из 3. Плюс
#    согласованы гейт БЛОКА справочника и гейт его СОДЕРЖИМОГО.
#
# 3. Пакет ревью. ⚠⚠ Главная находка — В ПРАВКЕ №2: предикат ловил любое «заключени», включая
#    ДЕЙСТВИЕ («при заключении СПИК», «заключение договора»), и справочник с разъяснением уезжал в
#    товарные вопросы — то есть `dbfc622` переоткрывался на другой ветке. Плюс шапка блока в
#    промпте была безусловной и велела ссылаться на «п. 4.2.1» там, где пунктов Приказа в контексте
#    НЕТ ВОВСЕ: номера пунктов не входят в заземление, `claim_numbers` их не считает — выдуманный
#    номер прошёл бы мимо всех гардов молча.
#
# ЗАМЕР: уровни 0–2, три прогона. Регрессий нет; документные метрики 0.75 x3 → 1.00 x3.
# Отчёт — docs/eval_runs/2026-08-26_level12.md. База обновлена до этого тега.
#
# ⚠ ВЫКАТКА РАНТАЙМОВАЯ. Корпус не тронут — ни одного файла knowledge_base/ в дельте, счётчики те же.
#
# ⚠⚠ ПОСЛЕ ВЫКАТКИ ЖИВАЯ ПРОВЕРКА ОБЯЗАНА БЫТЬ ПОВТОРНОЙ (3–5 прогонов). Правило куплено 25.08:
# единственный прогон поймал дефект частотой 2 из 5. Проверять ИМЕННО переехавшие вопросы:
# «как получить выписку из реестра», «нужно ли заключение ТПП для внесения продукции в реестр»,
# и контроль — «порядок получения загранпаспорта» (обязан остаться отказом «вне сферы»).

TAG="v0.5.0-test18"

EXPECT=([pp719]=1377 [pp719_rules]=328 [verified_cases]=12)

SNAPSHOT=""
SNAPSHOT_COLLECTION="pp719_rules"

REINDEX_FULL=""
REINDEX_DOCS=""

# Маркеры. ⚠ Без обратных слэшей — профиль читают ДВА разных механизма (`source` в скрипте и
# текстовый парсер в тесте), и экранирование они понимают по-разному (см. профиль test16).
MARKERS=(
  "app/rag/procedural.py|^def _has_routing_topic|P3: намерение вопроса как сигнал маршрута"
  "app/rag/procedural.py|_has_procedural_marker.q. or _has_routing_topic.q.|P3: маркер ЛИБО тема"
  "app/rag/procedural.py|_CHAMBER_MEMBERSHIP_RE|ревью: вопрос о членстве в палате — вне 719"
  "app/rag/procedural.py|торгово-промышленн|P3: ТПП добавлена в 719-якоря"
  "app/rag/procedural.py|внесени.включени.внести.включит|K15-1: один шаблон на все формы, асимметрии нет"
  "app/rag/documents_ref.py|^def asks_about_conclusion|K15-1: гейт блока согласован с гейтом содержимого"
  "app/rag/documents_ref.py|_CONCLUSION_AS_ACT|ревью: «заключение» как ДЕЙСТВИЕ справочник не зовёт"
  "app/rag/pipeline.py|^def plan_procedural|EV21: сборка процедурного контекста без вызова модели"
  "app/rag/pipeline.py|documents_points=bool|ревью: шапка блока знает, есть ли пункты Приказа"
  "app/core/prompts.py|documents_points: bool|ревью: вторая редакция шапки, без выдуманных номеров"
  "app/core/prompts.py|не ссылайся на их номера|ревью: прямой запрет придумывать номер пункта"
)

# ⚠ Анти-маркеры: формы, которые правки УБРАЛИ. Выдуманный анти-маркер бьёт по верному коду и
# дороже отсутствующего (урок 20.08), поэтому только то, чего в дереве действительно больше нет.
ANTI_MARKERS=(
  "app/rag/procedural.py|внести.s..w..:.s..w..{0,4}.s.в.s.реестр|K15-1: отдельный шаблон глагола удалён"
)
