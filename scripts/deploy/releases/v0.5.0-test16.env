# Профиль релиза v0.5.0-test16 (25.08.2026) — заход 5.5: гигиена замера, ретрива и выкатки.
#
# Вошли: две правки K15 по итогам живой проверки на бою (гард бил по ВЕРНЫМ ответам; разъяснение
# про несуществующий документ приезжало БЕЗУСЛОВНО и попадало в ответ пользователю, который о нём
# не спрашивал), EV18 #110 (жёсткий фильтр only_docs), плюс три предохранителя самой выкатки —
# O6 #114, O5 #113, EV19 #111.
#
# ⚠ ВЫКАТКА РАНТАЙМОВАЯ. Корпус не трогаем: ни снапшота, ни переиндексации. Правки живут в
# app/rag/{documents_ref,pipeline,retriever}.py и до ответа доезжают перезапуском контейнера.
# Счётчики коллекций обязаны ОСТАТЬСЯ прежними — если они изменятся, что-то пошло не так.
#
# ⚠⚠ ЭТО ПЕРВЫЙ РЕЛИЗ, ГДЕ ПРЕДОХРАНИТЕЛИ САМОГО СКРИПТА РАБОТАЮТ. До O6 #114 четыре проверки
# были недостижимым кодом (`| tail` съедал код возврата): бэкап боевой БД, обе ветки сборки образа
# и обе переиндексации. Если на этой выкатке что-то из них скажет «НЕ УДАЛОСЬ» — это не регресс
# скрипта, а первый раз, когда он вообще способен об этом сказать.

TAG="v0.5.0-test16"

# ⚠ ТЕ ЖЕ ЧИСЛА, что у test15: релиз рантаймовый, корпус не менялся.
EXPECT=([pp719]=1377 [pp719_rules]=328 [verified_cases]=12)

SNAPSHOT=""
SNAPSHOT_COLLECTION="pp719_rules"

# Ни полной, ни частичной переиндексации: корпус тот же.
REINDEX_FULL=""
REINDEX_DOCS=""

# Маркеры распакованного кода: файл|шаблон|описание. Шаблон ловит ОПРЕДЕЛЕНИЕ или присвоение,
# а не упоминание — урок 18.08, когда grep по имени константы поймал её в комментарии.
MARKERS=(
  "app/rag/documents_ref.py|^_DENIAL|K15: гард отличает отрицание от рекомендации"
  "app/rag/documents_ref.py|^_ASKS_ABOUT_CONCLUSION|K15: разъяснение только когда спросили"
  "app/rag/documents_ref.py|documents_context_block.query|K15: блок принимает вопрос"
  "app/rag/retriever.py|^def _doc_filter|EV18: жёсткий фильтр документов для запроса"
  "app/rag/retriever.py|only_docs: tuple|EV18: параметр в сигнатуре search_rules"
  "app/rag/pipeline.py|only_docs=.+tpp_order_52|EV18: блок документов просит фильтр, а не квоту"
)

# ⚠ ШАБЛОНЫ БЕЗ ОБРАТНЫХ СЛЭШЕЙ — ОСОЗНАННО. Профиль читается ДВАЖДЫ и по-разному: скрипт делает
# `source` (и тогда «\(» превращается в «(»), а тест `test_marker_patterns_compile` парсит файл
# КАК ТЕКСТ и видит ровно то, что записано. Пока в шаблоне нет экранирования, оба прочтения
# совпадают; с экранированием — расходятся, и тест падает на верном профиле.
# Найдено 25.08.2026 при заведении этого профиля.

# Анти-маркеры: код, которого в пакете быть НЕ должно.
# ⚠ Здесь он один и осмысленный: прежний вызов блока документов через `primary_docs` — ровно то,
# что EV18 и чинила. Если он вернётся, блок снова начнёт худеть на смешанных вопросах, и это
# будет молча: postфильтр отработает, ответ соберётся, просто пунктов в нём станет меньше.
ANTI_MARKERS=(
  "app/rag/pipeline.py|primary_docs=.+tpp_order_52|EV18: блок документов снова просит предпочтение вместо фильтра"
)
