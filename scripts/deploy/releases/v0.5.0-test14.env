# Профиль релиза v0.5.0-test14 (24.08.2026) — заход 4 + ревью + гигиена.
#
# Вошли: K8 #39 (манифест корпуса и паспорт записи), #106 (манифест на все три корпуса),
# K11 #41 (частичная переиндексация по документу), #105 (13 пунктов раздела IV Правил были
# подписаны разделом III), O3 #104 (тест EV16 стал офлайновым, гейт CI в выкатке),
# #107 (скрипты не падают на консоли Windows), плюс семь находок ревью захода 4.
#
# ⚠⚠ ВЫКАТКА С ПЕРЕИНДЕКСАЦИЕЙ `pp719_rules`. K8 и #105 меняют payload КАЖДОГО пункта
# процедурного корпуса: паспорт документа (сила, статус, срок) и исправленная привязка раздела.
# Без восстановления снапшота правки до ответа НЕ доедут — код будет новый, данные старые.
# Счётчик при этом обязан ОСТАТЬСЯ 311: переиндексация меняет содержимое точек, а не их число.
#
# ⚠ Товарный корпус `pp719` НЕ трогаем. Паспорт там тоже добавлен, но он аддитивный и пока
# никем не читается — фильтра по нему на товарном пути нет. Платить часом переиндексации 1377
# позиций за поле, которое понадобится только к K13/K14, незачем: K11 позволит сделать это
# отдельно и частично.

TAG="v0.5.0-test14"

EXPECT=([pp719]=1377 [pp719_rules]=311 [verified_cases]=12)

SNAPSHOT="pp719_rules.snapshot"
SNAPSHOT_COLLECTION="pp719_rules"

# Маркеры распакованного кода: файл|шаблон|описание. Шаблон ловит ОПРЕДЕЛЕНИЕ, а не упоминание.
MARKERS=(
  "app/core/manifest.py|^def load_manifest|K8: состав корпуса читается из манифеста"
  "app/core/manifest.py|^def resolve_sources|#106: источники документа, включая шаблоны и exclude"
  "app/core/console.py|^def enable_utf8|#107: скрипты не падают на консоли Windows"
  "app/rag/retriever.py|^def alive_only|K8: утративший силу документ не попадает в контекст"
  "scripts/load_rules_kb.py|^def reindex_document|K11: переиндексация одного документа"
  "scripts/load_rules_kb.py|^def corpus_avgdl|K11: avgdl берётся по всему корпусу, не по документу"
  "scripts/load_rules_kb.py|^_SECTION_HEAD_RE|#105: раздел из заголовка в теле, а не из имени файла"
  "knowledge_base/manifest.yaml|^  - doc_type: pp719_appendix|#106: товарный корпус описан"
)

# Анти-маркеры: код, которого в пакете быть НЕ должно.
# ⚠ `rules_recs` — локальная переменная СТАРОГО `load_records`, собиравшего корпус тремя
# списками путей. В новой версии её нет ни в коде, ни в комментариях (проверено grep'ом):
# урок 18.08 — шаблон, ловящий упоминание в комментарии, останавливает ВЕРНУЮ выкатку.
ANTI_MARKERS=(
  "scripts/load_rules_kb.py|rules_recs|старая сборка корпуса тремя списками путей (до K8)"
)
